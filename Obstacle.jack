class Obstacle {
    // Single large-triangle obstacle with fixed spawn interval
    field int x, y, width, height, speed;
    field boolean isVisible;
    field int hitboxX, hitboxY, hitboxWidth, hitboxHeight;
    field boolean randomMode;
    field boolean isSmall;

    constructor Obstacle new() {
        do reset();
        return this;
    }

    method void dispose() {
        do erase();
        do Memory.deAlloc(this);
        return;
    }

    method void update() {
        // update position and visibility safely
        if (isVisible) { do erase(); }
        let x = x - speed;
        // center hitbox under sprite horizontally
        let hitboxX = x + ((width - hitboxWidth) / 2);
        let hitboxY = y;
        // only draw if within screen X and Y bounds (replace >= and <=)
        if ((x > -width) & (x < 512)
            & ((y > 0) | (y = 0))
            & (((y + height) < 240) | ((y + height) = 240))) {
            let isVisible = true;
            do draw();
        } else {
         let isVisible = false;
         // reset when fully off left edge
         if (x < -width) { do reset(); }
        }
        return;
    }

    method void setRandomMode(boolean mode) {
        let randomMode = mode;
        return;
    }

    method void reset() {
        if (randomMode) {
            // Random spawn: choose small or big triangle and random offset
            let isSmall = (Random.randRange(0, 1) = 1);
            if (isSmall) {
                let width = 16;
                let height = 16;
                let hitboxWidth = 16;
                let hitboxHeight = 16;
            } else {
                let width = 32;
                let height = 32;
                let hitboxWidth = 24;
                let hitboxHeight = height;
            }
            // Random spawn distance between 0 and 25 pixels off screen
            let x = 511 + Random.randRange(0, 25);
            let y = Graphics.groundLevel() - height;
            // center hitbox under sprite horizontally
            let hitboxX = x + ((width - hitboxWidth) / 2);
            let hitboxY = y;
            let speed = 4;
            let isVisible = false;
            return;
        }
        let x = 511 + 100;            // Spawn 100px off right edge
        let width = 32;
        let height = 32;
        let hitboxWidth = 24;  // Reduced from 32 to 24
        let hitboxHeight = height;
        let y = Graphics.groundLevel() - height;
        // center hitbox under sprite horizontally
        let hitboxX = x + ((width - hitboxWidth) / 2);
        let hitboxY = y;
        let speed = 4;
        let isVisible = false;
        return;
    }

    method boolean collidesWith(Player player) {
        var int px, py, pw, ph;
        if (isVisible) {
            let px = player.collision_box_x()-32;
            let py = player.collision_box_y();
            let pw = player.collision_box_width();
            let ph = player.collision_box_height();
            if (((px + pw) > hitboxX) & (px < (hitboxX + hitboxWidth)) &
                ((py + ph) > hitboxY) & (py < (hitboxY + hitboxHeight))) {
                return true;
            }
        }
        return false;
    }

    method void draw() {
        if (randomMode) {
            if (isSmall){ 
                do Graphics.drawSmallTriangleObstacle(x, y);
            }
            else{ 
                do Graphics.drawTriangleObstacle(x, y);
            }
            return;
        }
        do Graphics.drawTriangleObstacle(x, y);
        return;
    }

    method void erase() {
        if (randomMode) {
            if (isSmall){ do Graphics.eraseSmallTriangleObstacle(x, y);}
            else{ do Graphics.eraseTriangleObstacle(x, y);}
            return;
        }
        do Graphics.eraseTriangleObstacle(x, y);
        return;
    }
    method int getX() {
        return x;
    }
    method int getWidth() {
        return width;
    }
    method void resetWithOffset(int minX) {
        do reset();
        if (x < minX) {
            let x = minX;
            // center hitbox under sprite horizontally
            let hitboxX = x + ((width - hitboxWidth) / 2);
            let hitboxY = y;
        }
        return;
    }
    method boolean isVisible() {
        return isVisible;
    }
}