class Graphics {
    // Screen memory calculation constants
    static int screenStart;
    static int screenSize;

    // Initialize graphics system
    function void init() {
        let screenStart = 16384;
        let screenSize = 8192;
        return;
    }

    // Checks if drawing at memAddress + maxOffset is within screen bounds
    function boolean isAddressValid(int memAddress, int maxOffset) {
        if ((memAddress + maxOffset > screenStart + screenSize) | (memAddress + maxOffset = screenStart + screenSize)) {
            return false;
        }
        return true;
    }

    // Calculate screen memory address from x,y coordinates
    function int getMemoryAddress(int x, int y) {
        return screenStart + (y * 32) + x;
    }

    // Draw player (32x32 sprite) at position x,y
    function void drawPlayer(int x, int y) {
        var int memAddress;
        let memAddress = Graphics.getMemoryAddress(x, y);

        // Column 0
        do Memory.poke(memAddress, -1);
        do Memory.poke(memAddress + 32, -1);
        do Memory.poke(memAddress + 64, -1);
        do Memory.poke(memAddress + 96, -1);
        do Memory.poke(memAddress + 128, -1);
        do Memory.poke(memAddress + 160, -1);
        do Memory.poke(memAddress + 192, -1);
        do Memory.poke(memAddress + 224, -1);
        do Memory.poke(memAddress + 256, -4033);
        do Memory.poke(memAddress + 288, -4033);
        do Memory.poke(memAddress + 320, -4033);
        do Memory.poke(memAddress + 352, -4033);
        do Memory.poke(memAddress + 384, -4033);
        do Memory.poke(memAddress + 416, -4033);
        do Memory.poke(memAddress + 448, -1);
        do Memory.poke(memAddress + 480, -1);
        do Memory.poke(memAddress + 512, -1);
        do Memory.poke(memAddress + 544, -1);
        do Memory.poke(memAddress + 576, -1);
        do Memory.poke(memAddress + 608, -1);
        do Memory.poke(memAddress + 640, 63);
        do Memory.poke(memAddress + 672, 63);
        do Memory.poke(memAddress + 704, 63);
        do Memory.poke(memAddress + 736, 63);
        do Memory.poke(memAddress + 768, -1);
        do Memory.poke(memAddress + 800, -1);
        do Memory.poke(memAddress + 832, -1);
        do Memory.poke(memAddress + 864, -1);
        do Memory.poke(memAddress + 896, -1);
        do Memory.poke(memAddress + 928, -1);
        do Memory.poke(memAddress + 960, -1);
        do Memory.poke(memAddress + 992, -1);

        // Column 1
        do Memory.poke(memAddress + 1, -1);
        do Memory.poke(memAddress + 33, -1);
        do Memory.poke(memAddress + 65, -1);
        do Memory.poke(memAddress + 97, -1);
        do Memory.poke(memAddress + 129, -1);
        do Memory.poke(memAddress + 161, -1);
        do Memory.poke(memAddress + 193, -1);
        do Memory.poke(memAddress + 225, -1);
        do Memory.poke(memAddress + 257, -1009);
        do Memory.poke(memAddress + 289, -1009);
        do Memory.poke(memAddress + 321, -1009);
        do Memory.poke(memAddress + 353, -1009);
        do Memory.poke(memAddress + 385, -1009);
        do Memory.poke(memAddress + 417, -1009);
        do Memory.poke(memAddress + 449, -1);
        do Memory.poke(memAddress + 481, -1);
        do Memory.poke(memAddress + 513, -1);
        do Memory.poke(memAddress + 545, -1);
        do Memory.poke(memAddress + 577, -1);
        do Memory.poke(memAddress + 609, -1);
        do Memory.poke(memAddress + 641, -1024);
        do Memory.poke(memAddress + 673, -1024);
        do Memory.poke(memAddress + 705, -1024);
        do Memory.poke(memAddress + 737, -1024);
        do Memory.poke(memAddress + 769, -1);
        do Memory.poke(memAddress + 801, -1);
        do Memory.poke(memAddress + 833, -1);
        do Memory.poke(memAddress + 865, -1);
        do Memory.poke(memAddress + 897, -1);
        do Memory.poke(memAddress + 929, -1);
        do Memory.poke(memAddress + 961, -1);
        do Memory.poke(memAddress + 993, -1);
        return;
    }

    // Erase player (32x32 sprite) at position x,y
    function void erasePlayer(int x , int y) {
        var int memAddress;
