    // Erase square obstacle 1 (32x32)
    function void eraseSquareObstacle1(int x, int y) {
        var int memAddress, i, offset;
        let memAddress = Graphics.getMemoryAddress(x, y);

        if (~Graphics.isAddressValid(memAddress, 993)) {
            return;
        }

        let i = 0;
        while (i < 32) {
            let offset = i * 32;
            do Memory.poke(memAddress + offset, 0);
            do Memory.poke(memAddress + offset + 1, 0);
            let i = i + 1;
        }
        return;
    }

