    // Draw triangular bed obstacle 1 (64x8)
    function void drawTriangularBed1(int x, int y) {
        var int memAddress;
        let memAddress = Graphics.getMemoryAddress(x, y);

        if (~Graphics.isAddressValid(memAddress, 227)) {
            return;
        }

        // column 0
        do Memory.poke(memAddress, ~32767);
        do Memory.poke(memAddress + 32, ~32767);
        do Memory.poke(memAddress + 64, -32736);
        do Memory.poke(memAddress + 96, -16288);
        do Memory.poke(memAddress + 128, -8080);
        do Memory.poke(memAddress + 160, -1800);
        do Memory.poke(memAddress + 192, -4);
        do Memory.poke(memAddress + 224, -1);

        // column 1
        do Memory.poke(memAddress + 33, 1);
        do Memory.poke(memAddress + 65, 1);
        do Memory.poke(memAddress + 97, 129);
        do Memory.poke(memAddress + 129, 8579);
        do Memory.poke(memAddress + 161, -1081);
        do Memory.poke(memAddress + 193, -9);
        do Memory.poke(memAddress + 225, -1);

        // column 2
        do Memory.poke(memAddress + 34, 16388);
        do Memory.poke(memAddress + 66, 28686);
        do Memory.poke(memAddress + 98, -2034);
        do Memory.poke(memAddress + 130, -481);
        do Memory.poke(memAddress + 162, -65);
        do Memory.poke(memAddress + 194, -1);
        do Memory.poke(memAddress + 226, -1);

        // column 3
        do Memory.poke(memAddress + 67, 1024);
        do Memory.poke(memAddress + 99, 3585);
        do Memory.poke(memAddress + 131, 3591);
        do Memory.poke(memAddress + 163, -12529);
        do Memory.poke(memAddress + 195, -97);
        do Memory.poke(memAddress + 227, -1);
        return;
    }

    // Erase triangular bed obstacle 1 (64x8)
    function void eraseTriangularBed1(int x, int y) {
        var int memAddress, i, j, offset;
        let memAddress = Graphics.getMemoryAddress(x, y);

        if (~Graphics.isAddressValid(memAddress, 227)) {
            return;
        }

        let i = 0;
        while (i < 8) {
            let offset = i * 32;
            let j = 0;
            while (j < 4) {  // 4 columns (64 pixels wide)
                do Memory.poke(memAddress + offset + j, 0);
                let j = j + 1;
            }
            let i = i + 1;
        }
        return;
    }

    // Draw triangular bed obstacle 2 (64x12)
    function void drawTriangularBed2(int x, int y) {
        var int memAddress;
        let memAddress = Graphics.getMemoryAddress(x, y);

        if (~Graphics.isAddressValid(memAddress, 355)) {
            return;
        }

        // column 0
        do Memory.poke(memAddress, 128);
        do Memory.poke(memAddress + 32, 384);
        do Memory.poke(memAddress + 64, 448);
        do Memory.poke(memAddress + 96, 448);
        do Memory.poke(memAddress + 128, 992);
        do Memory.poke(memAddress + 160, 1008);
        do Memory.poke(memAddress + 192, -31760);
        do Memory.poke(memAddress + 224, -15368);
        do Memory.poke(memAddress + 256, -14340);
        do Memory.poke(memAddress + 288, -6148);
        do Memory.poke(memAddress + 320, -4098);
        do Memory.poke(memAddress + 352, -1);

        // column 1
        do Memory.poke(memAddress + 33, 16384);
        do Memory.poke(memAddress + 65, -8192);
        do Memory.poke(memAddress + 97, -8192);
        do Memory.poke(memAddress + 129, -4096);
        do Memory.poke(memAddress + 161, -4095);
        do Memory.poke(memAddress + 193, -3967);
        do Memory.poke(memAddress + 225, -3903);
        do Memory.poke(memAddress + 257, -1821);
        do Memory.poke(memAddress + 289, -777);
        do Memory.poke(memAddress + 321, -1);
        do Memory.poke(memAddress + 353, -1);

        // column 2
        do Memory.poke(memAddress + 130, 1024);
        do Memory.poke(memAddress + 162, 1027);
        do Memory.poke(memAddress + 194, 3587);
        do Memory.poke(memAddress + 226, 7939);
        do Memory.poke(memAddress + 258, 8067);
        do Memory.poke(memAddress + 290, 16327);
        do Memory.poke(memAddress + 322, 32751);
        do Memory.poke(memAddress + 354, -1);

        // column 3
        do Memory.poke(memAddress + 35, 4096);
        do Memory.poke(memAddress + 67, 6144);
        do Memory.poke(memAddress + 99, 14336);
        do Memory.poke(memAddress + 131, 31744);
        do Memory.poke(memAddress + 163, 32256);
        do Memory.poke(memAddress + 195, 32512);
        do Memory.poke(memAddress + 227, 32640);
        do Memory.poke(memAddress + 259, 32736);
        do Memory.poke(memAddress + 291, 32760);
        do Memory.poke(memAddress + 323, -2);
        do Memory.poke(memAddress + 355, -1);
        return;
    }

    // Erase triangular bed obstacle 2 (64x12)
    function void eraseTriangularBed2(int x, int y) {
        var int memAddress, i, j, offset;
        let memAddress = Graphics.getMemoryAddress(x, y);

        if (~Graphics.isAddressValid(memAddress, 355)) {
            return;
        }

        let i = 0;
        while (i < 12) {
            let offset = i * 32;
            let j = 0;
            while (j < 4) {  // 4 columns (64 pixels wide)
                do Memory.poke(memAddress + offset + j, 0);
                let j = j + 1;
            }
            let i = i + 1;
        }
        return;
    }

    /** Returns the Y position of the ground level. */
    function int groundLevel() {
        return 240;
    }
    
    /** Draws a circle outline centered at (xc,yc) with radius r */
    function void drawCircle(int xc, int yc, int r) {
        // use built-in filled circle; radius must be <=181
        do Screen.drawCircle(xc, yc, r);
        return;
    }
}

