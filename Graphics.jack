    // Draw square obstacle (32x32)
    function void drawSquareBox(int x, int y, int size) {
        var int x0, y0, x1, y1;
        let x0 = x;
        let y0 = y;
        let x1 = x + size;
        let y1 = y + size;
        // clamp coordinates into valid screen region
        if (x0 < 0)   { let x0 = 0; }
        if (x0 > 511) { let x0 = 511; }
        if (x1 < 0)   { let x1 = 0; }
        if (x1 > 511) { let x1 = 511; }
        if (y0 < 0)   { let y0 = 0; }
        if (y0 > 239) { let y0 = 239; }
        if (y1 < 0)   { let y1 = 0; }
        if (y1 > 239) { let y1 = 239; }
        if ((x1 > x0) & (y1 > y0)) {
            do Screen.setColor(true);
            do Screen.drawRectangle(x0, y0, x1, y1);
        }
        return;
    }

    // Erase square obstacle (32x32)
    function void eraseSquareBox(int x, int y, int size) {
        var int x0, y0, x1, y1;
        let x0 = x;
        let y0 = y;
        let x1 = x + size;
        let y1 = y + size;
        // clamp coordinates into valid screen region
        if (x0 < 0)   { let x0 = 0; }
        if (x0 > 511) { let x0 = 511; }
        if (x1 < 0)   { let x1 = 0; }
        if (x1 > 511) { let x1 = 511; }
        if (y0 < 0)   { let y0 = 0; }
        if (y0 > 239) { let y0 = 239; }
        if (y1 < 0)   { let y1 = 0; }
        if (y1 > 239) { let y1 = 239; }
        if ((x1 > x0) & (y1 > y0)) {
            do Screen.setColor(false);
            do Screen.drawRectangle(x0, y0, x1, y1);
        }
        return;
    }

    // Draw ground at bottom of screen using a filled rectangle
    function void drawGround() {
        var int gy, y1;
        let gy = Graphics.groundLevel();
        // clamp start Y to screen max
        if (gy < 0)   { let gy = 0; }
        if (gy > 239) { let gy = 239; }
        let y1 = gy + 15;
        if (y1 > 239) { let y1 = 239; }
        do Screen.setColor(true);
        do Screen.drawRectangle(0, gy, 511, y1);
        return;
    }
