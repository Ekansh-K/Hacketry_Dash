    function void drawSmallTriangleObstacle(int x, int y) {
        var int drawX, drawWidth, drawHeight;

        let drawX = x;
        let drawWidth = 16;
        let drawHeight = 16;

        // Ensure drawing stays within screen bounds
        if (drawX < 0) {
            let drawWidth = drawWidth + drawX;
            let drawX = 0;
        }
        if ((drawX + drawWidth) > 511) {
            let drawWidth = 511 - drawX;
        }

        if (drawWidth > 0) {
            do Screen.setColor(true);
            // Draw the triangle using three lines
            do Screen.drawLine(drawX, y + drawHeight, drawX + drawWidth, y + drawHeight);
            do Screen.drawLine(drawX, y + drawHeight, drawX + (drawWidth / 2), y);
            do Screen.drawLine(drawX + drawWidth, y + drawHeight, drawX + (drawWidth / 2), y);
        }
