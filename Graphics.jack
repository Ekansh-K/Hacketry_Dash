   }

    // Draw large triangle obstacle (32x32)
    function void drawTriangleObstacle(int x, int y) {
        var int drawX, drawWidth, drawHeight;

        let drawX = x;
        let drawWidth = 32;
        let drawHeight = 32;

        // Ensure drawing stays within screen bounds
        if (drawX < 0) {
            let drawWidth = drawWidth + drawX;
            let drawX = 0;
        }
        if ((drawX + drawWidth) > 511) {
            let drawWidth = 511 - drawX;
        }

        if (drawWidth > 0) {
            do Screen.setColor(true);
            // Draw the triangle using three lines
            do Screen.drawLine(drawX, y + drawHeight, drawX + drawWidth, y + drawHeight);
            do Screen.drawLine(drawX, y + drawHeight, drawX + (drawWidth / 2), y);
            do Screen.drawLine(drawX + drawWidth, y + drawHeight, drawX + (drawWidth / 2), y);
        }
        return;
    }

    // Erase large triangle obstacle (32x32)
    function void eraseTriangleObstacle(int x, int y) {
        var int drawX, drawWidth, drawHeight;

        let drawX = x;
        let drawWidth = 32;
        let drawHeight = 32;

        // Ensure drawing stays within screen bounds
        if (drawX < 0) {
            let drawWidth = drawWidth + drawX;
            let drawX = 0;
        }
        if ((drawX + drawWidth) > 511) {
            let drawWidth = 511 - drawX;
        }

        if (drawWidth > 0) {
            do Screen.setColor(false);
            // Erase the triangle by drawing with color=false
            do Screen.drawLine(drawX, y + drawHeight, drawX + drawWidth, y + drawHeight);
            do Screen.drawLine(drawX, y + drawHeight, drawX + (drawWidth / 2), y);
            do Screen.drawLine(drawX + drawWidth, y + drawHeight, drawX + (drawWidth / 2), y);
        }
        return;
    }

